+# Starting values read off the data ---------------------------------------
+
+# .ndt_start() generalised: every natural-scale start a family can estimate
+# from its response, by matching moments. The rule for each family lives on
+# its registry entry as `data_init = function(s, p)` - beside `init`, where
+# the constants are - or in .DATA_INIT_PLAIN for the families in no registry.
+# `s` is .init_summary() of the DECISION times `y - ndt`, and `p` the natural-
+# scale values already known: the constants, with whatever the formula fixes
+# written over them, so that a rule can correct for the value of a parameter it
+# does not itself estimate (cogmod_lognormal()'s `sigmabias`, the Wald's
+# `sigmandt`). A rule returns a named list of the dpars it can place, or NULL
+# to decline; a family without one behaves exactly as before.
+#
+# `ndt` goes first, and that ordering is most of the design: every rule is a
+# moment match on the decision time, and .ndt_start() is what turns a response
+# into one. Its start is half the first percentile - deliberately below the
+# non-decision time, so `d` runs a little long and every rule inherits a small
+# upward bias in location. That is the cheap direction (see .ndt_start()), and
+# still an order of magnitude closer than a constant chosen for all data sets.
+#
+# All-or-nothing per family: a rule's estimates are jointly derived (the
+# Wald's threshold is its drift times the mean), so half of them applied over
+# the other half's constants would describe no distribution anyone intended.
+# One estimate not finite, or not strictly inside its dpar's support, and the
+# whole rule falls through, silently - a data set too small for the count
+# guard is the normal case for a pilot, not an error. The names that did come
+# from the data ride on the result as its "from_data" attribute.
+#
+# Deliberately NOT guarded: distance from the constant. Clamping each start
+# into a window around the old value would throw the benefit away exactly on
+# the unusual data set the constant serves worst. Guard on validity, and let
+# the fit be the judge.
+#
+# Nor is `0 + Intercept` treated specially, though it was considered. Under
+# the centred parameterization the intercept is the dpar at mean covariates,
+# which is what a marginal moment estimates; under `0 + Intercept` it is the
+# dpar at the reference level. For a START the two coincide: every slope
+# begins at zero, so the linear predictor is the intercept at every row either
+# way, and the pooled estimate is the right number for both.
+#' @keywords internal
+.data_start <- function(family, formula, sdata, targets) {
+  y <- .init_response(sdata)
+  if (!is.null(targets$ndt)) {
+    targets$ndt <- .ndt_start(y, targets$ndt)
+  }
+  fam <- .family_name(family)
+  rule <- .data_init_rule(fam)
+  if (is.null(rule)) {
+    return(targets)
+  }
+  fixed <- .fixed_dpars(formula)
+  known <- targets
+  known[names(fixed)] <- fixed
+  d <- if (is.null(targets$ndt)) y else y - targets$ndt
+  est <- .data_init_apply(rule, d, known, family)
+  # A fixed dpar is not a Stan parameter, so there is nothing to start; its
+  # target is left as the constant it always was.
+  est <- est[setdiff(names(est), names(fixed))]
+  targets[names(est)] <- est
+  attr(targets, "from_data") <- names(est)
+  targets
+}
+
+
+# The response as the model sees it: finite and positive, and where brms's
+# `cens()` is in play only the rows it observed outright. A right-censored row
+# carries the censoring time, which is a lower bound on the response and not a
+# response, and a moment taken over it is biased by however far the tail was
+# cut. `cens` is how make_standata() names the indicator: 0 for observed.
+#' @keywords internal
+.init_response <- function(sdata) {
+  y <- sdata$Y
+  keep <- is.finite(y) & y > 0
+  if (!is.null(sdata$cens) && length(sdata$cens) == length(y)) {
+    keep <- keep & sdata$cens == 0
+  }
+  y[keep]
+}
+
+
+# The moments the rules read, computed once, or NULL when there is not enough
+# to compute them from. Twenty is where a sample variance stops being noise
+# for the purpose - a start, not an estimate - and below it the constants are
+# the more honest guess anyway. Decision times at or below zero are dropped
+# rather than failing the log moments: .ndt_start() sits under the first
+# percentile, so there are never more than a handful, and each is a response
+# the model itself will hand to the outlier component.
+#' @keywords internal
+.init_summary <- function(d, min_n = 20L) {
+  d <- d[is.finite(d) & d > 0]
+  n <- length(d)
+  if (n < min_n) {
+    return(NULL)
+  }
+  m <- mean(d)
+  v <- stats::var(d)
+  if (!is.finite(v) || v <= 0) {
+    return(NULL)
+  }
+  ld <- log(d)
+  list(
+    n = n,
+    mean = m,
+    var = v,
+    sd = sqrt(v),
+    # Fisher skewness, the biased (moment) form: what the ex-Gaussian rule
+    # inverts, and at n >= 20 the small-sample correction is beside the point.
+    skew = mean((d - m)^3) / v^1.5,
+    meanlog = mean(ld),
+    sdlog = stats::sd(ld)
+  )
+}
+
+
+# The rule for a family, or NULL. The ndt families keep theirs on the registry
+# entry; the rest, which have no entry, in .DATA_INIT_PLAIN.
+#' @keywords internal
+.data_init_rule <- function(fam) {
+  if (is.null(fam)) {
+    return(NULL)
+  }
+  if (fam %in% .OUTLIER_FAMILIES) {
+    return(.mixture_spec(fam)$data_init)
+  }
+  .DATA_INIT_PLAIN[[fam]]
+}
+
+
+# Runs one rule and applies the guards: a summary to run it on, a result, and
+# every value finite and strictly inside its dpar's support, read off the
+# family object's `lb` / `ub` so that the check follows the family rather than
+# a copy of it. Any failure returns an empty list, which .data_start() treats
+# as "keep the constants".
+#' @keywords internal
+.data_init_apply <- function(rule, d, known, family) {
+  s <- .init_summary(d)
+  if (is.null(s)) {
+    return(list())
+  }
+  est <- tryCatch(
+    suppressWarnings(rule(s, known)),
+    error = function(e) NULL
+  )
+  if (!is.list(est) || !length(est) || is.null(names(est))) {
+    return(list())
+  }
+  ok <- vapply(
+    names(est),
+    function(p) {
+      v <- est[[p]]
+      i <- match(p, family$dpars)
+      if (is.na(i) || !is.numeric(v) || length(v) != 1 || !is.finite(v)) {
+        return(FALSE)
+      }
+      lb <- family$lb[[i]]
+      ub <- family$ub[[i]]
+      (is.na(lb) || v > lb) && (is.na(ub) || v < ub)
+    },
+    logical(1)
+  )
+  if (!all(ok)) {
+    return(list())
+  }
+  est
+}
+
+
+# The dpars the formula pins - `bf(..., sigmabias = 0)` - as a named list of
+# natural-scale values. brms records them on the terms object rather than the
+# family, so this is the one place they can be read; anything going wrong
+# here means "none known", which only costs a rule the correction it would
+# have made.
+#' @keywords internal
+.fixed_dpars <- function(formula) {
+  bt <- tryCatch(brms::brmsterms(formula), error = function(e) NULL)
+  fd <- bt$fdpars
+  if (!length(fd)) {
+    return(list())
+  }
+  vals <- lapply(fd, function(x) x$value)
+  vals[vapply(vals, function(v) is.numeric(v) && length(v) == 1, logical(1))]
+}
+
+
+# Wald (drift, threshold) from the mean and variance of the decision time. A
+# first-passage time with drift v and threshold a has mean a / v and variance
+# a / v^3, so the ratio gives the drift and the mean then gives the threshold.
+# A uniform non-decision range `sigmandt` already known to be in play adds
+# sigmandt / 2 to the mean and sigmandt^2 / 12 to the variance, and is taken
+# out first. Exact at sigmadrift = 0, which is where cogmod_invgaussian()
+# starts it; drift variability fattens the tail, so the start's drift runs a
+# little low there. cogmod_bisa() carries the same currency but its own closed
+# form, on its entry: its moments are the Wald's plus a term in the drift alone.
+#' @keywords internal
+.wald_start <- function(mean, var, sigmandt = 0) {
+  m <- mean - sigmandt / 2
+  v <- var - sigmandt^2 / 12
+  if (!(m > 0 && v > 0)) {
+    return(NULL)
+  }
+  drift <- sqrt(m / v)
+  list(mu = drift, boundary = drift * m)
+}
+
+
+# A two-parameter family whose coefficient of variation depends on the shape
+# alone: solve the CV for the shape on a log grid by root finding, then read
+# the scale off the mean. `cv2` is the squared CV as a function of the shape,
+# decreasing on `range` (the Weibull's and the Frechet's both are); a squared
+# sample CV outside what the range can produce declines rather than clamps.
+#' @keywords internal
+.shape_scale_start <- function(s, cv2, range, mean_of) {
+  target <- s$var / s$mean^2
+  f <- function(lk) cv2(exp(lk)) - target
+  lo <- log(range[1])
+  hi <- log(range[2])
+  if (!(f(lo) > 0 && f(hi) < 0)) {
+    return(NULL)
+  }
+  k <- exp(stats::uniroot(f, c(lo, hi), tol = 1e-9)$root)
+  list(mu = k, sigma = s$mean / mean_of(k))
+}
+
+
