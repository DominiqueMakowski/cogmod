+# cogmod_inits: starts read off the data ----------------------------------
+
+# Every rule against its family's own RNG at known parameters, handed the
+# decision times themselves so that the rule is what is tested and not the
+# bias .ndt_start() builds in on purpose. This is the failure that matters
+# most: a parameterization misread off the registry entry would put the start
+# below the constant on every data set, silently.
+test_that("the data-aware rules recover their parameters", {
+  set.seed(42)
+  n <- 1e5
+  # `fixed` plays the part of a dpar pinned in bf(), which the rule is told
+  # about; `tol` is relative, and loose only where the estimator is noisy
+  # (the ex-Gaussian's sigma is the square root of a small difference).
+  cases <- list(
+    list(fam = "cogmod_lognormal", truth = list(mu = -0.4, sigma = 0.35),
+         fixed = list(sigmabias = 0),
+         draw = function() rcogmod_lognormal(n, mu = -0.4, sigma = 0.35,
+                                             ndt = 0, sigmabias = 0)),
+    # the start-point range at its constant, corrected for
+    list(fam = "cogmod_lognormal", truth = list(mu = -0.4, sigma = 0.35),
+         draw = function() rcogmod_lognormal(n, mu = -0.4, sigma = 0.35,
+                                             ndt = 0, sigmabias = 0.5)),
+    list(fam = "cogmod_logstudent", truth = list(mu = -0.4, sigma = 0.3),
+         draw = function() rcogmod_logstudent(n, mu = -0.4, sigma = 0.3,
+                                              dof = 5, ndt = 0)),
+    list(fam = "cogmod_loggamma", truth = list(mu = -0.4, sigma = 0.3),
+         draw = function() rcogmod_loggamma(n, mu = -0.4, sigma = 0.3,
+                                            shape = 0, ndt = 0)),
+    list(fam = "cogmod_loggamma", truth = list(mu = -0.4, sigma = 0.3),
+         fixed = list(shape = 0.8),
+         draw = function() rcogmod_loggamma(n, mu = -0.4, sigma = 0.3,
+                                            shape = 0.8, ndt = 0)),
+    list(fam = "cogmod_logweibull", truth = list(mu = -0.6, sigma = 0.25),
+         draw = function() rcogmod_logweibull(n, mu = -0.6, sigma = 0.25,
+                                              ndt = 0)),
+    list(fam = "cogmod_invgaussian", truth = list(mu = 4, boundary = 0.8),
+         draw = function() rcogmod_invgaussian(n, drift = 4, boundary = 0.8,
+                                               ndt = 0, sigmadrift = 0,
+                                               sigmandt = 0.05)),
+    list(fam = "cogmod_bisa", truth = list(mu = 4, boundary = 0.8),
+         draw = function() rcogmod_bisa(n, mu = 4, boundary = 0.8, ndt = 0)),
+    list(fam = "cogmod_gamma", truth = list(mu = 3, sigma = 0.15),
+         draw = function() rcogmod_gamma(n, mu = 3, sigma = 0.15, ndt = 0)),
+    list(fam = "cogmod_invgamma", truth = list(mu = 5, sigma = 1.2),
+         draw = function() rcogmod_invgamma(n, mu = 5, sigma = 1.2, ndt = 0)),
+    list(fam = "cogmod_weibull", truth = list(mu = 2.5, sigma = 0.6),
+         draw = function() rcogmod_weibull(n, mu = 2.5, sigma = 0.6, ndt = 0)),
+    list(fam = "cogmod_invweibull", truth = list(mu = 4, sigma = 0.4),
+         draw = function() rcogmod_invweibull(n, mu = 4, sigma = 0.4, ndt = 0)),
+    list(fam = "cogmod_exgaussian",
+         truth = list(mu = 0.45, sigma = 0.08, tau = 0.25), tol = 0.12,
+         draw = function() rcogmod_exgaussian(n, mu = 0.45, sigma = 0.08,
+                                              tau = 0.25)),
+    list(fam = "cogmod_geg",
+         truth = list(mu = 0.45, sigma = 0.08, tau = 0.25), tol = 0.12,
+         draw = function() rcogmod_geg(n, mu = 0.45, sigma = 0.08, tau = 0.25,
+                                       shape = 1))
+  )
+  for (cs in cases) {
+    family <- get(cs$fam, envir = asNamespace("cogmod"))()
+    known <- cogmod:::.init_targets(family)
+    known[names(cs$fixed)] <- cs$fixed
+    est <- cogmod:::.data_init_apply(
+      cogmod:::.data_init_rule(cs$fam), cs$draw(), known, family
+    )
+    expect_setequal(names(est), names(cs$truth))
+    tol <- if (is.null(cs$tol)) 0.05 else cs$tol
+    for (p in names(cs$truth)) {
+      expect_equal(est[[p]], cs$truth[[p]], tolerance = tol,
+                   info = paste(cs$fam, p))
+    }
+  }
+})
+
+
+test_that("the data-aware rules fall through to the constants when they should", {
+  f <- brms::bf(RT ~ 1, sigma ~ 1, sigmabias = 0, family = cogmod_lognormal())
+  # Fewer than 20 usable responses: the summary is not computed at all, and
+  # the constants stand. A pilot data set doing this is normal, not an error.
+  few <- cogmod_inits(f, d_ig[1:15, ], jitter = 0)
+  expect_null(attr(attr(few, "targets"), "from_data"))
+  expect_equal(few(1)$Intercept, -0.7)
+  expect_equal(few(1)$Intercept_sigma, log(expm1(0.5)))
+  # No variance: same.
+  flat <- transform(d_ig, RT = 0.5)
+  expect_null(attr(attr(cogmod_inits(f, flat, jitter = 0), "targets"), "from_data"))
+
+  # The summary itself
+  expect_null(cogmod:::.init_summary(1:10))
+  expect_null(cogmod:::.init_summary(rep(1, 30)))
+  # non-finite and non-positive decision times are dropped, not fatal
+  expect_equal(cogmod:::.init_summary(c(seq(0.5, 1.5, length.out = 30), NA, -1, 0))$n, 30)
+
+  # A rule's estimates have to be finite and strictly inside the support, or
+  # none of them is used: they are jointly derived, and half a rule over half
+  # the constants describes nothing anyone intended.
+  set.seed(9)
+  d <- rcogmod_gamma(500, mu = 3, sigma = 0.15, ndt = 0)
+  fam <- cogmod_gamma()
+  known <- cogmod:::.init_targets(fam)
+  apply_rule <- function(rule) cogmod:::.data_init_apply(rule, d, known, fam)
+  expect_length(apply_rule(function(s, p) list(mu = -1, sigma = 0.2)), 0)
+  expect_length(apply_rule(function(s, p) list(mu = 2, sigma = NA_real_)), 0)
+  expect_length(apply_rule(function(s, p) list(mu = 2, sigma = Inf)), 0)
+  expect_length(apply_rule(function(s, p) stop("no")), 0)
+  expect_length(apply_rule(function(s, p) NULL), 0)
+  expect_length(apply_rule(function(s, p) list(nosuchdpar = 1)), 0)
+  expect_named(apply_rule(function(s, p) list(mu = 2, sigma = 0.2)), c("mu", "sigma"))
+
+  # The ex-Gaussian rule declines a sample with no positive skewness - a
+  # left-skewed one here - where the cube root has nothing to take.
+  expect_null(cogmod:::.exgaussian_start(cogmod:::.init_summary(1 - rexp(500, 10))))
+})
+
+
+test_that("a dpar fixed in bf() is seen by the rule and not started", {
+  set.seed(5)
+  y <- rcogmod_lognormal(2000, mu = -0.4, sigma = 0.3, ndt = 0.2, sigmabias = 0)
+  fam <- cogmod_lognormal()
+  targets <- cogmod:::.init_targets(fam)
+  free <- cogmod:::.data_start(
+    fam, brms::bf(y ~ 1, family = fam), list(Y = y), targets
+  )
+  pinned <- cogmod:::.data_start(
+    fam, brms::bf(y ~ 1, sigmabias = 0, family = fam), list(Y = y), targets
+  )
+  # Same decision times either way, so the two differ by exactly the
+  # E[log(1 + U(0, 0.5))] the free rule takes out for a range it believes
+  # is 0.5 and the pinned rule knows is 0.
+  m1 <- (1.5 * log(1.5) - 0.5) / 0.5
+  expect_equal(pinned$mu - free$mu, m1)
+  # and the free rule takes the range's log variance out of sigma too
+  expect_gt(pinned$sigma, free$sigma)
+  # The pinned dpar is not a Stan parameter, so nothing is started for it and
+  # its target stays the constant; it is not claimed as read off the data.
+  expect_equal(pinned$sigmabias, 0.5)
+  expect_setequal(attr(pinned, "from_data"), c("mu", "sigma"))
+  expect_equal(cogmod:::.fixed_dpars(brms::bf(y ~ 1, sigmabias = 0, family = fam)),
+               list(sigmabias = 0))
+  expect_equal(cogmod:::.fixed_dpars(brms::bf(y ~ 1, family = fam)), list())
+})
+
+
+test_that("a censored response contributes only its observed rows", {
+  cut <- quantile(d_ig$RT, 0.8, names = FALSE)
+  dc <- transform(d_ig, cens = ifelse(RT > cut, "right", "none"),
