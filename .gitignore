# Clinical data for paper/example_cnp.R, downloaded from OpenNeuro ds000030.
# Not redistributed - see paper/download_cnp.R to fetch them.
paper/cnp_data/
paper/paper_cache/

# Derived intermediate for paper/make_fig_approaches.py, regenerated by
# paper/make_figures.R from rtdists. Not redistributed - see the Open
# Practices Statement in paper/paper.qmd.
paper/wagenmakers2008.csv
paper/reviewers.txt

# Compiled Stan executables produced by benchmarks/*.R
benchmarks/results/exe/
# Output of the two gradient scripts (benchmarks/gradient_check.R and
# gradient_cost.R): generated Stan programs, their executables and the
# per-point CSVs. CI keeps them as workflow artifacts; locally they are
# regenerated on every run.
benchmarks/results/gradient_check/
benchmarks/results/gradient_cost/

# Warm-start ablation benchmark (benchmarks/warmstart_ablation.R): only the
# per-fit results and the summary CSV are kept, and the figure lives in
# man/figures/. The log, the pilot and reference warm-start tables (there so a
# resumed session need not refit) and the per-fit posterior summaries (folded
# into the summary's sd_ratio / z_shift) are regenerable.
benchmarks/results/warmstart_ablation.log
benchmarks/results/warmstart_ablation_*_pilot.csv
benchmarks/results/warmstart_ablation_*_reference_seed*.csv
benchmarks/results/warmstart_ablation_postsd.csv
benchmarks/results/warmstart_ablation.png
# Local launchers for the benchmarks
benchmarks/*.bat
# Superseded benchmark runs, kept locally for reference
benchmarks/results/archive-*/
# Probit-vs-logit benchmark for the dropped cogmod_gaussbit()
# (benchmarks/gaussbit/links/bench.R): only the three CSVs are kept; the
# generated programs, their executables and the log are regenerable.
benchmarks/gaussbit/links/results/*.exe
benchmarks/gaussbit/links/results/*.stan
benchmarks/gaussbit/links/results/run.log*
# benchmarks/gaussbit/lognorbit_cost.R: likewise, only its CSVs are kept.
benchmarks/gaussbit/results/*.exe
benchmarks/gaussbit/results/*.stan
benchmarks/gaussbit/results/run.log

# The animation scripts import a shared module, which leaves one of these.
__pycache__/
